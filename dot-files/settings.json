{
  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "nix.enableLanguageServer": true,
  "nix.serverPath": "nixd",
  "nix.serverSettings": {
    "nixd": {
      "formatting": { "command": ["alejandra"] },
      "options": {
        "nixos": {
          "expr": "(builtins.getFlake \"/home/jzahm/nixos\").nixosConfigurations.nixos.options"
        },
        "home-manager": {
          "expr": "(builtins.getFlake \"/home/jzahm/nixos\").nixosConfigurations.nixos.options.home-manager.users.type.getSubOptions []"
        }
      }
    }
  }
}
